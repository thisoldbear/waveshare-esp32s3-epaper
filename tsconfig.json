{
  "compilerOptions": {
    "target": "ES5",
    "module": "CommonJS",
    "lib": ["ES2018", "DOM"],
    "downlevelIteration": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*", "projects/*/src/**/*"],
  "exclude": ["node_modules", "dist", "projects/**/test/**/*", "**/*.test.ts"]
}
